# Application
    APP_ENV=development
    HTTP_PORT=8080

    # Database (PostgreSQL - for Phase 3)
    DB_HOST=localhost
    DB_PORT=5432
    DB_USER=postgres
    DB_PASSWORD=postgres
    DB_NAME=taskflow_db
    DB_SSLMODE=disable

    # Cache (Redis - for Phase 9)
    REDIS_HOST=localhost
    REDIS_PORT=6379
    REDIS_PASSWORD=

    # Security (JWT - for Phase 6)
    JWT_SECRET=supersecretjwtkey_at_least_32_characters_long
    JWT_EXPIRATION_HOURS=24